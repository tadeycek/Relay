{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2023"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src",
    "test",
    "client",
    "vitest.config.ts"
  ]
}
