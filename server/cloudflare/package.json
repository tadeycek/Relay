{
  "name": "relay-mailbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay's private encrypted mailbox: a Cloudflare Worker in front of one SQLite-backed Durable Object.",
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false >/dev/null && tsc --noEmit && tsc --noEmit -p tools",
    "test": "vitest run",
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "pilot": "node tools/pilot.ts"
  },
  "dependencies": {
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@noble/hashes": "2.0.1",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
